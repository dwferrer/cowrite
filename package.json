{
  "name": "cowrite",
  "version": "0.0.1",
  "private": true,
  "description": "Illustrated co-writing with an LLM: a snappy web interface over a powerful agent harness.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @cowrite/server start",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @cowrite/web test:e2e",
    "mock:llm": "pnpm --filter @cowrite/mock-llm standalone --only llm",
    "mock:comfy": "pnpm --filter @cowrite/mock-llm standalone --only comfy",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0"
  }
}
